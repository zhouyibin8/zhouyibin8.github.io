---
import Base from '../layouts/Base.astro';
---

<Base lang="en" path="" title="Page not found">
  <header class="page-head">
    <p class="eyebrow">404</p>
    <h1 class="page-title">Page not found · 页面不存在</h1>
    <p class="page-lede">
      The page you were looking for has moved or no longer exists.<br />
      你要找的页面已移动或不存在。
    </p>
    <p class="page-lede">
      <a href="/en/">Home</a> · <a href="/zh/">首页</a>
    </p>
  </header>
</Base>
