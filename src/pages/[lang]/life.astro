---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getProfile, getShows, getTravel } from '../../lib/data';
import { langPaths, pick, t, type Lang } from '../../lib/i18n';

// Hidden from /admin → Profile → "Show Life page": the page is not built at all.
export const getStaticPaths = async () => ((await getProfile()).show_life ? langPaths() : []);

const lang = Astro.params.lang as Lang;

const large = (src: ImageMetadata) => getImage({ src, width: Math.min(1600, src.width), format: 'webp' });

const travel = await Promise.all(
  (await getTravel()).map(async ({ data: d }) => ({
    photo: d.photo,
    full: (await large(d.photo)).src,
    title: pick(lang, d.place, d.place_zh),
    sub: d.region ? pick(lang, d.region, d.region_zh) : undefined,
    date: d.date,
  })),
);
const shows = await Promise.all(
  (await getShows()).map(async ({ data: d }) => ({
    photo: d.photo,
    full: (await large(d.photo)).src,
    title: pick(lang, d.name, d.name_zh),
    sub: undefined,
    date: d.date,
  })),
);

const galleries = [
  { id: 'travel', title: t(lang, 'travel'), intro: t(lang, 'travelIntro'), unit: t(lang, 'places'), items: travel },
  { id: 'shows', title: t(lang, 'shows'), intro: t(lang, 'showsIntro'), unit: t(lang, 'nights'), items: shows },
];
---

<Base lang={lang} path="life/" title={t(lang, 'life')}>
  <header class="page-head">
    <h1 class="page-title">{t(lang, 'life')}</h1>
    <nav class="tabs" aria-label={t(lang, 'life')}>
      {
        galleries.map((g) => (
          <a href={`#${g.id}`}>
            {g.title}
            <span>{g.items.length}</span>
          </a>
        ))
      }
    </nav>
  </header>

  {
    galleries.map((g) => (
      <section class="section" id={g.id}>
        <h2 class="section-title">
          {g.title}
          <span class="count">
            {g.items.length} {g.unit}
          </span>
        </h2>
        <p class="gallery-intro">{g.intro}</p>
        <ul class="gallery" role="list">
          {g.items.map((item) => (
            <li>
              <button
                class="tile"
                type="button"
                aria-label={item.title}
                data-full={item.full}
                data-caption={[item.title, item.sub, item.date].filter(Boolean).join(' · ')}
              >
                <Image
                  src={item.photo}
                  alt={item.title}
                  widths={[240, 400, 560]}
                  sizes="(min-width: 68rem) 210px, (min-width: 40rem) 30vw, 45vw"
                />
              </button>
              <p class="tile-caption">
                <span class="tile-title">{item.title}</span>
                <span class="tile-meta">{[item.sub, item.date].filter(Boolean).join(' · ')}</span>
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-family: var(--sans);
    font-size: 0.875rem;
  }
  .tabs a {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink-2);
    text-decoration: none;
  }
  .tabs a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .tabs span {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .gallery-intro {
    margin-top: -0.75rem;
    color: var(--muted);
    font-style: italic;
  }
  .gallery {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1rem;
  }
  @media (min-width: 40rem) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem 1.25rem;
    }
  }
  @media (min-width: 68rem) {
    .gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .tile {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--surface-2);
    border-radius: 8px;
    overflow: hidden;
    cursor: zoom-in;
    aspect-ratio: 4 / 5;
  }
  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.3s;
  }
  .tile:hover :global(img) {
    transform: scale(1.04);
  }
  .tile-caption {
    margin: 0.6rem 0 0;
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }
  .tile-title {
    font-size: 1.02rem;
    font-weight: 600;
  }
  .tile-meta {
    font-family: var(--sans);
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }
</style>
