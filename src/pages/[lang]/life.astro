---
import Base from '../../layouts/Base.astro';
import LifeContent from '../../components/LifeContent.astro';
import { getProfile } from '../../lib/data';
import { langPaths, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = async () => ((await getProfile()).show_life ? langPaths() : []);
const lang = Astro.params.lang as Lang;
if ((await getProfile()).theme === 'night-one-page') return Astro.redirect(`/${lang}/#life`);
---

<Base lang={lang} path="life/" title={t(lang, 'life')}>
  <LifeContent lang={lang} />
</Base>
