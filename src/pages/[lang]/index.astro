---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProfileLinks from '../../components/ProfileLinks.astro';
import PubEntry from '../../components/PubEntry.astro';
import { getProfile, getSelectedPublications } from '../../lib/data';
import { md } from '../../lib/format';
import { langPaths, pick, t, type Lang } from '../../lib/i18n';
import { homeLayout } from '../../lib/themes';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const profile = await getProfile();
const layout = homeLayout[profile.theme];
const selected = await getSelectedPublications();

const name = pick(lang, profile.name, profile.name_zh);
const position = pick(lang, profile.position, profile.position_zh);
const department = pick(lang, profile.department, profile.department_zh);
const university = pick(lang, profile.university, profile.university_zh);
const tagline = profile.tagline ? pick(lang, profile.tagline, profile.tagline_zh) : undefined;
---

<Base lang={lang} path="">
  {
    layout === 'centered' && (
      <section class="hero-centered">
        {profile.photo && (
          <Image
            class="hero-photo"
            src={profile.photo}
            alt={name}
            widths={[176, 352]}
            sizes="176px"
            loading="eager"
            fetchpriority="high"
          />
        )}
        <h1 class="hero-name">
          {name}
          {profile.preferred_name && lang === 'en' && <span class="aka"> ({profile.preferred_name})</span>}
        </h1>
        <p class="hero-role">{position}</p>
        <p class="hero-affil">
          {department}
          <br />
          {university}
        </p>
        {tagline && <p class="hero-tagline">{tagline}</p>}
        <ProfileLinks profile={profile} lang={lang} variant="icons" />
        <a class="hero-next" href="#about" aria-label={t(lang, 'scrollDown')}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </section>
    )
  }

  {
    layout === 'split' && (
      <section class="hero-split">
        <div>
          <p class="hero-role">{position}</p>
          <h1 class="hero-name">
            {name}
            {profile.preferred_name && lang === 'en' && <span class="aka"> ({profile.preferred_name})</span>}
          </h1>
          <p class="hero-affil">
            {department}
            <br />
            {university}
          </p>
          {tagline && <p class="hero-tagline">{tagline}</p>}
          <ProfileLinks profile={profile} lang={lang} variant="buttons" />
        </div>
        {profile.photo && (
          <Image
            class="hero-photo"
            src={profile.photo}
            alt={name}
            widths={[300, 600]}
            sizes="(min-width: 48rem) 300px, 60vw"
            loading="eager"
            fetchpriority="high"
          />
        )}
        <a class="hero-next" href="#about" aria-label={t(lang, 'scrollDown')}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </section>
    )
  }

  <section id="about" class:list={['about', { section: layout !== 'sidebar' }]}>
    <h2 class="section-title">{t(lang, 'home')}</h2>
    <div class="entry about-body">
      <div class="prose" set:html={md(pick(lang, profile.bio, profile.bio_zh))} />
      {
        profile.interests.length > 0 && (
          <div class="interests">
            <p class="label">{t(lang, 'researchInterests')}</p>
            <ul class="chips" role="list">
              {profile.interests.map((i) => (
                <li class="chip">{pick(lang, i.en, i.zh)}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  {
    selected.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t(lang, 'selectedPublications')}</h2>
        <div class="entries">
          {selected.map((entry) => (
            <PubEntry entry={entry} lang={lang} highlight={profile.highlight_author} />
          ))}
        </div>
        <p class="section-more">
          <a href={`/${lang}/publications/`}>{t(lang, 'allPublications')} →</a>
        </p>
      </section>
    )
  }
</Base>

<style>
  .hero-centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(1rem, 4vw, 2.5rem) 0.5rem;
  }
  /* On screens wider than a phone the introduction fills the first screen exactly;
     About starts just below the fold. 4.25rem + 1px is the header, and the negative
     margin cancels main's top padding. */
  .hero-next {
    display: none;
  }
  @media (min-width: 40rem) {
    .hero-centered,
    .hero-split {
      position: relative;
      min-height: calc(100svh - 4.25rem - 1px);
      margin-top: calc(-1 * clamp(2.25rem, 5vw, 3.75rem));
      padding-block: 2.5rem 4.5rem;
    }
    .hero-centered {
      justify-content: center;
    }
    .hero-split {
      align-content: center;
    }
    .hero-next {
      position: absolute;
      bottom: 1.25rem;
      left: 50%;
      translate: -50% 0;
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 999px;
      color: var(--muted);
      animation: hero-nudge 2.4s ease-in-out infinite;
    }
    .hero-next:hover {
      color: var(--accent);
      background: var(--surface-2);
    }
  }
  @keyframes hero-nudge {
    50% {
      transform: translateY(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-next {
      animation: none;
    }
  }
  .about {
    scroll-margin-top: 5.5rem;
  }
  .hero-centered :global(.hero-photo) {
    width: 176px;
    height: 176px;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--photo-radius);
    margin-bottom: 1.5rem;
  }
  [data-theme='night'] .hero-centered :global(.hero-photo) {
    box-shadow: 0 0 0 4px #2a2b30, 0 0 0 5px #3a3c42;
  }
  [data-theme='day'] .hero-centered :global(.hero-photo) {
    box-shadow: 0 0 0 4px #fff, 0 0 0 5px #e3e5e9;
  }
  .hero-name {
    font-size: clamp(2.3rem, 6vw, 3.25rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .aka {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.6em;
    letter-spacing: 0;
  }
  .hero-role {
    margin: 0.75rem 0 0;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero-split .hero-role {
    margin: 0 0 0.75rem;
  }
  .hero-affil {
    margin: 0.6rem 0 0;
    color: var(--ink-2);
    font-size: 1.08rem;
    line-height: 1.55;
  }
  .hero-tagline {
    margin: 0.75rem 0 0;
    color: var(--muted);
  }
  .hero-centered :global(.profile-links) {
    margin-top: 1.1rem;
  }

  .hero-split {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 48rem) {
    .hero-split {
      grid-template-columns: 1fr 300px;
      gap: 4rem;
    }
  }
  .hero-split :global(.profile-links) {
    margin-top: 1.5rem;
  }
  .hero-split :global(.hero-photo) {
    width: min(70vw, 300px);
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--photo-radius);
    box-shadow: var(--shadow);
    order: -1;
  }
  @media (min-width: 48rem) {
    .hero-split :global(.hero-photo) {
      width: 100%;
      order: 0;
    }
  }

  .about-body {
    display: grid;
    gap: 1.5rem;
  }
  .about-body .prose {
    max-width: none;
  }
  .about-body :global(strong) {
    font-weight: 600;
  }
  .interests .label {
    margin-bottom: 0.6rem;
  }
  [data-theme='sidebar'] .about-body,
  [data-theme='minimal'] .about-body {
    padding-top: 1.25rem;
  }
</style>
