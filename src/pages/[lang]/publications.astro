---
import Base from '../../layouts/Base.astro';
import PublicationsContent from '../../components/PublicationsContent.astro';
import { getProfile } from '../../lib/data';
import { langPaths, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
if ((await getProfile()).theme === 'night-one-page') return Astro.redirect(`/${lang}/#publications`);
---

<Base lang={lang} path="publications/" title={t(lang, 'publications')}>
  <PublicationsContent lang={lang} />
</Base>
