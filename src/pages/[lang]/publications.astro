---
import Base from '../../layouts/Base.astro';
import Authors from '../../components/Authors.astro';
import Icon from '../../components/Icon.astro';
import PubEntry from '../../components/PubEntry.astro';
import { getProfile, getPublications, getTalks } from '../../lib/data';
import { fullDate } from '../../lib/format';
import { langPaths, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const profile = await getProfile();
const pubs = await getPublications();
const talks = await getTalks();

const groups = [
  { key: 'journal', title: t(lang, 'journalArticles'), items: pubs.filter((p) => ['published', 'in-press'].includes(p.data.status)) },
  { key: 'review', title: t(lang, 'underReview'), items: pubs.filter((p) => p.data.status === 'under-review') },
  { key: 'working', title: t(lang, 'workingPapers'), items: pubs.filter((p) => p.data.status === 'working-paper') },
].filter((g) => g.items.length > 0);

const hasCorresponding = [...pubs.flatMap((p) => p.data.authors), ...talks.flatMap((x) => x.data.authors)].some((a) =>
  a.trim().endsWith('#'),
);
const kindLabel = { presentation: t(lang, 'presentation'), invited: t(lang, 'invited'), poster: t(lang, 'poster'), panel: t(lang, 'panel') };
---

<Base lang={lang} path="publications/" title={t(lang, 'publications')}>
  <header class="page-head">
    <p class="eyebrow">{lang === 'zh' ? '研究' : 'Research'}</p>
    <h1 class="page-title">{t(lang, 'publications')}</h1>
    {
      profile.scholar && (
        <p class="page-lede">
          <a class="btn" href={profile.scholar}>
            <Icon name="scholar" />
            Google Scholar
          </a>
        </p>
      )
    }
  </header>

  {
    groups.map((g) => (
      <section class="section" id={g.key}>
        <h2 class="section-title">
          {g.title} <span class="count">{g.items.length}</span>
        </h2>
        <div>
          {g.items.map((entry) => (
            <PubEntry entry={entry} lang={lang} highlight={profile.highlight_author} />
          ))}
        </div>
      </section>
    ))
  }

  {
    talks.length > 0 && (
      <section class="section" id="presentations">
        <h2 class="section-title">
          {t(lang, 'presentations')} <span class="count">{talks.length}</span>
        </h2>
        <ol class="talks" role="list">
          {talks.map(({ data: x }) => (
            <li class="talk">
              <p class="talk-kind">{kindLabel[x.kind]}</p>
              <h3 class="talk-title">{x.url ? <a href={x.url}>{x.title}</a> : x.title}</h3>
              <p class="talk-authors">
                <Authors authors={x.authors} highlight={profile.highlight_author} />
              </p>
              <p class="talk-meta">
                <em>{x.event}</em>
                <span>{x.date_text ?? fullDate(x.date, lang)}</span>
                {x.location && (
                  <span class="talk-loc">
                    <Icon name="pin" />
                    {x.location}
                  </span>
                )}
              </p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {hasCorresponding && <p class="footnote">{t(lang, 'correspondingNote')}</p>}
</Base>

<style>
  .talks {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .talk {
    padding-block: 1.4rem;
    border-top: 1px solid var(--rule);
  }
  .talk:first-child {
    border-top: 0;
    padding-top: 0.25rem;
  }
  .talk-kind {
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.35rem;
  }
  .talk-title {
    font-size: 1.15rem;
    line-height: 1.35;
  }
  .talk-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .talk-authors {
    margin: 0.35rem 0 0;
    font-size: 1rem;
  }
  .talk-meta {
    margin: 0.3rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1rem;
    font-size: 1rem;
    color: var(--ink-2);
  }
  .talk-meta em {
    color: var(--ink);
  }
  .talk-loc {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--muted);
  }
  .footnote {
    margin-top: 3rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
