---
import '../styles/global.css';
import { Image } from 'astro:assets';
import ProfileLinks from '../components/ProfileLinks.astro';
import { getProfile } from '../lib/data';
import { htmlLang, otherLang, pick, t, type Lang } from '../lib/i18n';
import { homeLayout } from '../lib/themes';

interface Props {
  lang: Lang;
  /** Page path without the language prefix, e.g. "" for home or "publications/". */
  path: string;
  title?: string;
  description?: string;
}

const { lang, path, title, description } = Astro.props;
const profile = await getProfile();
const theme = profile.theme;
const withSidebar = homeLayout[theme] === 'sidebar';
const name = pick(lang, profile.name, profile.name_zh);
const position = pick(lang, profile.position, profile.position_zh);
const pageTitle = title ? `${title} · ${name}` : `${name} · ${position}`;
const metaDescription =
  description ??
  `${position}, ${pick(lang, profile.department, profile.department_zh)}, ${pick(lang, profile.university, profile.university_zh)}.`;
const site = Astro.site!;
const canonical = new URL(`/${lang}/${path}`, site).href;
const alternate = new URL(`/${otherLang(lang)}/${path}`, site).href;

const nav = [
  { href: `/${lang}/`, label: t(lang, 'home'), key: '' },
  { href: `/${lang}/publications/`, label: t(lang, 'publications'), key: 'publications/' },
  { href: `/${lang}/cv/`, label: t(lang, 'cv'), key: 'cv/' },
  { href: `/${lang}/life/`, label: t(lang, 'life'), key: 'life/' },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.preferred_name,
  jobTitle: profile.position,
  affiliation: { '@type': 'CollegeOrUniversity', name: profile.university },
  email: profile.email ? `mailto:${profile.email}` : undefined,
  url: new URL('/en/', site).href,
  sameAs: [profile.scholar, profile.orcid, profile.linkedin, profile.github, profile.researchgate].filter(Boolean),
};
const builtAt = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang={htmlLang[lang]} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={htmlLang[lang]} href={canonical} />
    <link rel="alternate" hreflang={htmlLang[otherLang(lang)]} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/en/${path}`, site).href} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/icon-512.png', site).href} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'zh' ? '跳到正文' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={`/${lang}/`}>
          <img class="brand-mark" src="/apple-touch-icon.png" alt="" width="30" height="30" />
          <span>{name}</span>
        </a>
        <nav class="nav" aria-label={lang === 'zh' ? '主导航' : 'Main'}>
          {
            nav.map((item) => (
              <a href={item.href} aria-current={item.key === path ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a
            class="lang-switch"
            href={`/${otherLang(lang)}/${path}`}
            hreflang={htmlLang[otherLang(lang)]}
            lang={htmlLang[otherLang(lang)]}
            title={t(lang, 'switchLabel')}
            aria-label={t(lang, 'switchLabel')}
          >
            {t(lang, 'switchTo')}
          </a>
        </nav>
      </div>
    </header>

    <div class:list={['frame', { 'with-sidebar': withSidebar }]}>
      {
        withSidebar && (
          <aside class="sidebar" aria-label={name}>
            {profile.photo && (
              <Image class="sidebar-photo" src={profile.photo} alt={name} widths={[248, 496]} sizes="248px" />
            )}
            <p class="sidebar-name">{name}</p>
            <p class="sidebar-role">{position}</p>
            <p class="sidebar-affil">
              {pick(lang, profile.department, profile.department_zh)}
              <br />
              {pick(lang, profile.university, profile.university_zh)}
            </p>
            <ProfileLinks profile={profile} lang={lang} variant="list" />
          </aside>
        )
      }
      <main id="main">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <div class="container">
        <span>© {builtAt.slice(0, 4)} {profile.name}</span>
        <span>{t(lang, 'lastUpdated')}{lang === 'zh' ? '：' : ': '}<time datetime={builtAt}>{builtAt}</time></span>
      </div>
    </footer>
  </body>
</html>

<style>
  .sidebar {
    padding-top: clamp(2.25rem, 5vw, 3.75rem);
  }
  @media (min-width: 56rem) {
    .sidebar {
      position: sticky;
      top: 4.25rem;
      align-self: start;
      max-height: calc(100vh - 4.25rem);
      overflow-y: auto;
    }
  }
  @media (max-width: 55.99rem) {
    .sidebar {
      display: grid;
      grid-template-columns: 6rem 1fr;
      column-gap: 1.25rem;
      align-items: start;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--rule);
    }
    .sidebar > :not(.sidebar-photo) {
      grid-column: 2;
    }
    .sidebar :global(.sidebar-photo) {
      grid-row: 1 / span 5;
    }
  }
  .sidebar :global(.sidebar-photo) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--photo-radius);
    margin-bottom: 1.1rem;
  }
  .sidebar-name {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }
  .sidebar-role {
    margin: 0.3rem 0 0;
    color: var(--accent);
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .sidebar-affil {
    margin: 0.5rem 0 1rem;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.5;
  }
</style>
