---
import Icon from './Icon.astro';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<!-- One viewer per page: any element with data-full="<large image url>" opens it, with data-caption below. -->
<dialog class="lightbox">
  <form method="dialog">
    <button class="lightbox-close" aria-label={t(lang, 'close')}><Icon name="x" /></button>
  </form>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const img = dialog?.querySelector('img');
  const caption = dialog?.querySelector('figcaption');
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-full]');
    if (!trigger || !dialog || !img || !caption) return;
    img.src = trigger.dataset.full ?? '';
    img.alt = trigger.getAttribute('aria-label') ?? '';
    caption.textContent = trigger.dataset.caption ?? '';
    dialog.setAttribute('aria-label', caption.textContent || img.alt);
    dialog.showModal();
  });
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => img?.removeAttribute('src'));
</script>

<style>
  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(92vw, 1100px);
    max-height: 92vh;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgb(12 10 8 / 0.86);
  }
  .lightbox figure {
    margin: 0;
  }
  .lightbox img {
    max-width: 100%;
    max-height: 82vh;
    margin-inline: auto;
    border-radius: 6px;
    /* Figures with transparent backgrounds stay readable. */
    background: #fff;
  }
  .lightbox figcaption {
    margin-top: 0.75rem;
    text-align: center;
    color: #efe8de;
    font-family: var(--sans);
    font-size: 0.9rem;
  }
  .lightbox-close {
    position: absolute;
    top: -2.75rem;
    right: 0;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    font-size: 1.1rem;
    cursor: pointer;
  }
</style>
