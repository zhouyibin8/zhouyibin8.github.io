---
import Icon from './Icon.astro';
import { t, type Lang } from '../lib/i18n';
import type { getProfile } from '../lib/data';

interface Props {
  profile: Awaited<ReturnType<typeof getProfile>>;
  lang: Lang;
  /** "icons": compact icon row; "buttons": labelled buttons; "list": icon + label rows. */
  variant: 'icons' | 'buttons' | 'list';
}

const { profile, lang, variant } = Astro.props;
const links = [
  profile.email && { href: `mailto:${profile.email}`, label: t(lang, 'email'), text: profile.email, icon: 'mail' as const },
  profile.scholar && { href: profile.scholar, label: 'Google Scholar', icon: 'scholar' as const },
  profile.orcid && { href: profile.orcid, label: 'ORCID', icon: 'orcid' as const },
  profile.linkedin && { href: profile.linkedin, label: 'LinkedIn', icon: 'linkedin' as const },
  profile.github && { href: profile.github, label: 'GitHub', icon: 'github' as const },
  profile.researchgate && { href: profile.researchgate, label: 'ResearchGate', icon: 'researchgate' as const },
].filter((l) => !!l);
---

<ul class:list={['profile-links', variant]} role="list">
  {
    links.map((l) => (
      <li>
        {variant === 'icons' ? (
          <a class="icon-link" href={l.href} title={l.label} aria-label={l.label}>
            <Icon name={l.icon} />
          </a>
        ) : variant === 'buttons' ? (
          <a class="btn" href={l.href}>
            <Icon name={l.icon} />
            {l.label}
          </a>
        ) : (
          <a href={l.href}>
            <Icon name={l.icon} />
            <span>{l.text ?? l.label}</span>
          </a>
        )}
      </li>
    ))
  }
  {
    profile.cv_pdf && (
      <li>
        <a class:list={[variant === 'list' ? '' : 'btn btn-primary']} href={profile.cv_pdf}>
          <Icon name="file" />
          {variant !== 'icons' && <span>{t(lang, 'cv')} (PDF)</span>}
        </a>
      </li>
    )
  }
</ul>

<style>
  .profile-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .icons {
    gap: 0.2rem;
    justify-content: center;
  }
  .list {
    flex-direction: column;
    gap: 0.15rem;
    font-family: var(--sans);
    font-size: 0.86rem;
  }
  .list a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0;
    color: var(--ink-2);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .list a:hover {
    color: var(--accent);
  }
  .list :global(svg) {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--muted);
  }
</style>
