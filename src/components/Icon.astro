---
interface Props {
  name: 'mail' | 'scholar' | 'orcid' | 'linkedin' | 'github' | 'researchgate' | 'external' | 'file' | 'quote' | 'text' | 'pin' | 'x' | 'sun' | 'moon';
  label?: string;
}
const { name, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<svg viewBox="0 0 24 24" width="1em" height="1em" {...a11y}>
  {name === 'mail' && (
    <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
    </g>
  )}
  {name === 'scholar' && (
    <path fill="currentColor" d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3Zm-7 10.18v4L12 21l7-3.82v-4L12 17l-7-3.82Z" />
  )}
  {name === 'orcid' && (
    <g>
      <circle cx="12" cy="12" r="10.5" fill="currentColor" />
      <path fill="var(--bg)" d="M8.1 9.6h1.6v7.2H8.1zM8.9 6.6a1 1 0 1 1 0 2 1 1 0 0 1 0-2zM11.2 9.6h3.1c2.2 0 3.6 1.5 3.6 3.6s-1.4 3.6-3.6 3.6h-3.1V9.6zm1.6 1.4v4.4h1.4c1.3 0 2.1-.9 2.1-2.2s-.8-2.2-2.1-2.2h-1.4z" />
    </g>
  )}
  {name === 'linkedin' && (
    <g>
      <rect x="2" y="2" width="20" height="20" rx="3" fill="currentColor" />
      <path fill="var(--bg)" d="M6.3 9.5h2.4v8H6.3zM7.5 5.6a1.4 1.4 0 1 1 0 2.8 1.4 1.4 0 0 1 0-2.8zM10.4 9.5h2.3v1.1c.3-.6 1.1-1.3 2.4-1.3 2.5 0 2.9 1.6 2.9 3.8v4.4h-2.4v-3.9c0-.9 0-2.1-1.3-2.1s-1.5 1-1.5 2v4h-2.4v-8z" />
    </g>
  )}
  {name === 'github' && (
    <path fill="currentColor" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-1.97c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
  )}
  {name === 'researchgate' && (
    <g>
      <rect x="2" y="2" width="20" height="20" rx="3" fill="currentColor" />
      <text x="12" y="16.2" text-anchor="middle" font-family="Georgia, serif" font-size="10" font-weight="700" fill="var(--bg)">RG</text>
    </g>
  )}
  {name === 'external' && (
    <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M8 7h9v9" />
  )}
  {name === 'file' && (
    <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
      <path d="M14 3v5h5M9 13h6M9 17h6" />
    </g>
  )}
  {name === 'text' && (
    <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M5 7h14M5 12h14M5 17h9" />
  )}
  {name === 'quote' && (
    <path fill="currentColor" d="M10 7H6a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v1.5A1.5 1.5 0 0 1 6.5 18H6v2h.5A3.5 3.5 0 0 0 10 16.5V9a2 2 0 0 0 0-2Zm10 0h-4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v1.5a1.5 1.5 0 0 1-1.5 1.5H16v2h.5a3.5 3.5 0 0 0 3.5-3.5V9a2 2 0 0 0 0-2Z" />
  )}
  {name === 'pin' && (
    <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
      <circle cx="12" cy="10" r="2.3" />
    </g>
  )}
  {name === 'sun' && (
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
    </g>
  )}
  {name === 'moon' && (
    <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" />
  )}
  {name === 'x' && (
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6 6 18" />
  )}
</svg>
