---
import { getAuthorLinks } from '../lib/data';
import { splitAuthor } from '../lib/format';

interface Props {
  authors: string[];
  highlight: string;
}
const { authors, highlight } = Astro.props;
const links = await getAuthorLinks();
const list = authors.map(splitAuthor).map((a) => ({ ...a, url: links.get(a.name) }));
---

<span class="authors">
  {
    list.map((a, i) => (
      <>
        {a.url ? (
          <a class:list={['author-link', { me: a.name === highlight }]} href={a.url}>
            {a.name}
          </a>
        ) : a.name === highlight ? (
          <strong class="me">{a.name}</strong>
        ) : (
          <span>{a.name}</span>
        )}
        {a.marks && <sup>{a.marks}</sup>}
        {i < list.length - 1 && ', '}
      </>
    ))
  }
</span>

<style>
  .authors {
    color: var(--ink-2);
  }
  .me {
    color: var(--ink);
    font-weight: 600;
  }
  .author-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }
  .author-link:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  sup {
    font-family: var(--sans);
    font-size: 0.65em;
    margin-left: 0.05em;
    color: var(--muted);
  }
</style>
